{
  "expo": {
    "name": "Planner",
    "slug": "iosplanner",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.andrehbarrozo.planner"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ]
    ]
  }
}
